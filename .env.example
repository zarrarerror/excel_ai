# Hostname only here; HTTPS origin without trailing slash in PUBLIC_URL.
DOMAIN=excel.example.com
PUBLIC_URL=https://excel.example.com
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-on-server-only
SUPABASE_ANON_KEY=replace-with-public-anon-key
OPENAI_API_KEY=replace-on-server-only
OPENAI_MODEL_FAST=gpt-4o
OPENAI_MODEL_HEAVY=gpt-4o
ADMIN_SECRET=replace-with-a-long-random-secret
FREE_USES_LIMIT=50
PRO_USES_LIMIT=1000
# Full chat storage is opt-in. Token accounting remains enabled.
CHAT_LOGGING_ENABLED=false
# Normally empty: taskpane and API share one origin.
ALLOWED_ORIGINS=
